// Prisma schema for Harvestlink — defines the PostgreSQL data model for a multi-store retail co-op.
// Migrations for this schema live under backend/prisma/migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Roles that control what a user can do in the co-op platform (POS, store ops, or co-op-wide admin).
enum Role {
  CASHIER
  STORE_ADMIN
  COOP_ADMIN
}

/// Lifecycle of a co-op member (owners). Members are NEVER hard-deleted — withdrawal preserves history.
enum MemberStatus {
  PENDING
  ACTIVE
  WITHDRAWN
  SUSPENDED
  DECEASED
  TRANSFERRED
}

/// Payment lifecycle for CapitalInvestment (equity stake — NOT store revenue).
/// CONFIRMED (formerly PAID) means funds are received and count toward totalInvested / voting.
enum CapitalPaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

/// Payment lifecycle for the one-time MembershipFee (joining fee — confers NO votes).
enum MembershipFeeStatus {
  PENDING
  CONFIRMED
  FAILED
}

/// How a declared Dividend pool is split across members.
/// Configurable ON PURPOSE: classic co-ops often use patronage; Harvestlink's current terms
/// say by investment. Legal counsel may advise changing this — never hardcode the formula.
enum DividendAllocationMethod {
  BY_CAPITAL
  BY_PATRONAGE
  HYBRID
}

enum DividendStatus {
  DECLARED
  ALLOCATED
  PAID
  CANCELLED
}

enum BoardResolutionOutcome {
  PENDING
  PASSED
  FAILED
  TABLED
}

enum BallotStatus {
  OPEN
  CLOSED
  CANCELLED
}

/// Kind of configurable member perk (R2 benefits engine — replaces hard-coded tier %).
enum BenefitType {
  PERCENT_DISCOUNT
  FIXED_DISCOUNT
  FREE_DELIVERY
  EARLY_ACCESS
  EXCLUSIVE_PRODUCT
  BULK_PRICING
  BIRTHDAY_CREDIT
  STORE_CREDIT
  FREE_ITEM
}

/// How narrowly a MemberBenefit applies in the catalog / network.
enum BenefitScope {
  ALL_PRODUCTS
  CATEGORY
  PRODUCT
  STORE
  NETWORK_WIDE
}

/// Window used when enforcing MemberBenefit.maxUsesPerPeriod caps.
enum BenefitPeriod {
  PER_TRANSACTION
  DAILY
  MONTHLY
  ANNUAL
  LIFETIME
}

/// Who absorbs the cost of a member discount at a store (moves to OperatorAgreement in P3).
enum DiscountBearer {
  OPERATOR
  COOP
  SHARED
}

/// Stripe / card payment lifecycle for a Sale. Physical stock decrements only when PAID.
/// EXPIRED = abandoned PENDING past reservationExpiresAt (reservation released by cleanup job).
/// REFUNDING = DB claimed a refund before Stripe; finalize to REFUNDED/PAID or reconcile if stuck.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  EXPIRED
  REFUNDING
}

/// How the customer pays: Terminal / Checkout = card via Stripe; CASH skips Stripe and finalizes immediately.
enum PaymentMethod {
  TERMINAL
  CHECKOUT
  CASH
}

/// Lifecycle of an inventory lot (batch of a product at a store).
/// Available to sell from a lot = quantityRemaining - quantityReserved, and ONLY when
/// status = ACTIVE. QUARANTINED and RECALLED lots are never sellable.
enum LotStatus {
  ACTIVE
  QUARANTINED
  RECALLED
  EXPIRED
  DEPLETED
}

/// Stock-holding location kind. Warehouses share Store / storeId with retail (lots, FEFO, counts…).
enum LocationType {
  RETAIL_STORE
  WAREHOUSE
}

/// A stock-holding location in the co-op network (retail store or warehouse). Don't rename the model.
model Store {
  /// Primary key uniquely identifying this store.
  id              String   @id @default(cuid())
  /// Human-readable store name shown in admin and POS UIs.
  name            String
  /// Street / mailing address of the store for records and logistics.
  address         String
  /// RETAIL_STORE (POS) or WAREHOUSE (no POS; co-op operated). Immutable once lots or sales exist.
  locationType    LocationType @default(RETAIL_STORE)
  /// Fixed percentage of store sales the operator earns (snapshotted onto each Sale so history stays stable).
  /// Applied to PRE-TAX subtotal only — sales tax is remitted to the state, not co-op revenue.
  /// Must be 0 for WAREHOUSE (the co-op runs it).
  operatorPercent Decimal  @db.Decimal(5, 2)
  /// Sales-tax rate (%) applied to non-exempt line items at this store.
  taxRate         Decimal  @default(0) @db.Decimal(5, 2)
  /// Printed on receipts (returns / exchanges policy).
  refundPolicy    String   @default("Returns accepted within 14 days with receipt. Refunds to original form of payment.")
  /// When false, this store does not apply NETWORK_WIDE / co-op network member benefits.
  /// Lets the co-op admin exclude a store from network benefits, useful mid-onboarding.
  honorsNetworkBenefits Boolean @default(true)
  /// Who funds member discounts rung at this store (COOP / OPERATOR / SHARED).
  memberDiscountBearer DiscountBearer @default(COOP)
  /// When memberDiscountBearer = SHARED, percent of the discount borne by the operator (0–100).
  /// Moves to OperatorAgreement in P3. See the split rules in a later step.
  memberDiscountSharedPercent Decimal @default(0) @db.Decimal(5, 2)
  /// When this store record was created in the system.
  createdAt       DateTime @default(now())
  /// Whether the store is currently operating; inactive stores should not take new sales.
  isActive        Boolean  @default(true)

  /// Users (cashiers / store admins) assigned to this store.
  users   User[]
  /// Catalog products sold at this store.
  products Product[]
  /// Completed sales that occurred at this store.
  sales   Sale[]
  /// Operator payouts issued against this store's earned commission.
  payouts Payout[]
  /// Manual stock adjustments recorded for products at this store.
  stockAdjustments StockAdjustment[]
  /// Inventory lots (batches) received / held at this store.
  lots Lot[]
  /// Cash drawer shifts for this store.
  cashDrawers CashDrawer[]
  /// Cash taken from this store's tills to the bank.
  cashDeposits CashDeposit[]
  /// Offline / sync stock conflicts awaiting human review.
  stockReconciliations StockReconciliation[]
  /// Purchase orders targeted at this store (null on PO = co-op central buy).
  purchaseOrders PurchaseOrder[]
  /// Physical stock counts taken at this store.
  stockCounts StockCount[]
  /// Scannable codes registered against this store's products.
  productBarcodes ProductBarcode[]
  /// CooperativeSettings rows that name this location as the main warehouse (0–1 in practice).
  mainWarehouseFor CooperativeSettings[] @relation("MainWarehouse")
  /// Import shipments destined for this location (usually the main warehouse).
  importShipmentsDestination ImportShipment[] @relation("ImportShipmentDestination")
}

/// An authenticated account for cashiers, store admins, or co-op admins.
model User {
  /// Primary key uniquely identifying this user.
  id           String   @id @default(cuid())
  /// Store this user works at; null for co-op admins who are not tied to one store.
  storeId      String?
  /// Login email address; must be unique across the platform.
  email        String   @unique
  /// Bcrypt (or similar) hash of the user's password — never store plaintext.
  passwordHash String
  /// Authorization role determining accessible features and APIs.
  role         Role
  /// Consecutive failed login attempts; reset on successful login.
  failedLoginAttempts Int @default(0)
  /// When set and in the future, login is rejected until this timestamp.
  lockedUntil  DateTime?
  /// Seeded / provisional accounts must change password before using the API.
  mustChangePassword Boolean @default(false)
  /// When this user account was created.
  createdAt    DateTime @default(now())

  /// Store assignment for store-scoped staff; null means co-op-wide (admin) scope.
  store           Store?  @relation(fields: [storeId], references: [id])
  /// Sales rung up by this user acting as cashier.
  salesAsCashier  Sale[]  @relation("SaleCashier")
  /// Operator payouts this user recorded as having been paid.
  payoutsPaid     Payout[] @relation("PayoutPaidBy")
  /// Manual inventory adjustments this user recorded (shrinkage, recounts, etc.).
  stockAdjustments StockAdjustment[] @relation("StockAdjustedBy")
  /// Cash drawers this user opened.
  drawersOpened CashDrawer[] @relation("DrawerOpenedBy")
  /// Cash drawers this user closed.
  drawersClosed CashDrawer[] @relation("DrawerClosedBy")
  /// Purchase orders this user created.
  purchaseOrdersCreated PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  /// Goods receipts this user recorded at the dock.
  goodsReceiptsReceived GoodsReceipt[] @relation("GoodsReceiptReceivedBy")
  /// Members this user approved into ACTIVE status.
  membersApproved Member[] @relation("MemberApprovedBy")
  /// MemberBenefit rows this user created (versioned perk definitions).
  memberBenefitsCreated MemberBenefit[] @relation("MemberBenefitCreatedBy")
  /// MembershipFee rows this user confirmed as received.
  membershipFeesConfirmed MembershipFee[] @relation("MembershipFeeConfirmedBy")
  /// CapitalInvestment rows this user confirmed as received.
  capitalInvestmentsConfirmed CapitalInvestment[] @relation("CapitalInvestmentConfirmedBy")
  /// Recalls this user initiated (regulatory — never delete these rows).
  recallsInitiated Recall[] @relation("RecallInitiatedBy")
  /// Cash deposits this user recorded as taken to the bank.
  cashDepositsRecorded  CashDeposit[] @relation("CashDepositDepositedBy")
  /// Cash deposits this user confirmed against the bank statement.
  cashDepositsConfirmed CashDeposit[] @relation("CashDepositConfirmedBy")
  /// Cash deposits this user disputed.
  cashDepositsDisputed  CashDeposit[] @relation("CashDepositDisputedBy")
  /// Stock counts this user created / scheduled.
  stockCountsCreated  StockCount[] @relation("StockCountCreatedBy")
  /// Stock counts this user physically counted.
  stockCountsCounted  StockCount[] @relation("StockCountCountedBy")
  /// Stock counts this user approved.
  stockCountsApproved StockCount[] @relation("StockCountApprovedBy")
  /// Count lines this user counted first.
  stockCountLinesCounted   StockCountLine[] @relation("StockCountLineCountedBy")
  /// Count lines this user recounted.
  stockCountLinesRecounted StockCountLine[] @relation("StockCountLineRecountedBy")
  /// Catalog backfill disagreements this user marked resolved.
  catalogDisagreementsResolved CatalogDisagreement[] @relation("CatalogDisagreementResolvedBy")
  /// Import shipments this user created.
  importShipmentsCreated ImportShipment[] @relation("ImportShipmentCreatedBy")
  /// Append-only import shipment timeline events this user recorded.
  shipmentEventsCreated ShipmentEvent[] @relation("ShipmentEventCreatedBy")
  /// Binary documents this user uploaded (PDFs / images).
  documentsUploaded Document[] @relation("DocumentUploadedBy")
  /// Supplier certifications this user verified.
  certificationsVerified SupplierCertification[] @relation("CertificationVerifiedBy")
  /// Shipment compliance documents this user attached.
  shipmentDocumentsUploaded ShipmentDocument[] @relation("ShipmentDocumentUploadedBy")
  /// Landed-cost variance rows this user recognised (true-up / restock reversal).
  landedCostVariancesCreated LandedCostVariance[] @relation("LandedCostVarianceCreatedBy")

  @@index([storeId])
}

/// Which CatalogItem identity field locations disagreed on during backfill.
enum CatalogDisagreementField {
  name
  category
  taxExempt
}

/// Open (or resolved) SKU identity mismatch across locations — survives multi-host deploys
/// (unlike a local JSON file). One open row per sku+field; resolve records who accepted chosenValue.
///
/// Partial unique index `CatalogDisagreement_sku_field_open_key` (sku, field WHERE resolvedAt IS NULL)
/// is created in raw SQL — Prisma 6 cannot express it. If a generated migration contains
/// DROP INDEX for it, delete that line.
model CatalogDisagreement {
  id               String                    @id @default(cuid())
  sku              String
  field            CatalogDisagreementField
  /// Distinct values with the store ids that hold each (JSON array).
  values           Json
  /// Mode / chosen master value (string form; booleans as "true"/"false").
  chosenValue      String
  resolvedAt       DateTime?
  resolvedByUserId String?
  createdAt        DateTime                  @default(now())

  resolvedBy User? @relation("CatalogDisagreementResolvedBy", fields: [resolvedByUserId], references: [id])

  @@index([resolvedAt])
  @@index([sku, field])
}

/// Network master for a SKU — shared identity across every stock-holding location.
/// Location Products copy sku/name/category/taxExempt from here; only local price/cost/stock vary.
model CatalogItem {
  id             String   @id @default(cuid())
  /// Network-unique SKU code.
  sku            String   @unique
  name           String
  category       String
  taxExempt      Boolean  @default(false)
  isActive       Boolean  @default(true)
  /// Sellable units in one case (≥ 1).
  unitsPerCase   Int      @default(1)
  /// Cases that make a full pallet; null when the SKU is not shipped as full pallets.
  casesPerPallet Int?
  caseWeightKg   Decimal? @db.Decimal(12, 3)
  caseGtin       String?
  /// Co-op ceiling at retail stores — Product.price at a RETAIL_STORE must be ≤ this.
  maxShelfPrice  Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]
}

/// A location's instance of a CatalogItem (stock + local retail price / cost).
model Product {
  /// Primary key uniquely identifying this product row.
  id        String   @id @default(cuid())
  /// Store that owns this catalog entry (SKU uniqueness is per store, not global).
  storeId   String
  /// Network master SKU this location row mirrors (null only until backfill).
  catalogItemId String?
  /// Store-local stock keeping unit code used at POS and receiving — owned by CatalogItem.
  sku       String
  /// Display name — owned by CatalogItem; edit the master, not this row.
  name      String
  /// Merchandising category — owned by CatalogItem.
  category  String
  /// Current retail selling price charged to the customer (≤ CatalogItem.maxShelfPrice at retail).
  price     Decimal  @db.Decimal(12, 2)
  /// Unit cost to the co-op / store, used for margin analysis (4 dp; rollup totals stay 2 dp).
  cost      Decimal  @db.Decimal(14, 4)
  /// Units physically on hand at this store (shelf / backroom count).
  /// Do NOT treat this alone as sellable qty while unpaid PENDING sales exist.
  stock     Int
  /// Units spoken for by unpaid PENDING sales (explicit reservation).
  /// Available to sell = stock - reserved. FOR UPDATE + reserved must stay — do not
  /// "simplify" back to checking only `stock` at createSale then decrementing later:
  /// that race lets two cashiers charge cards for the last unit (see sales.service).
  reserved  Int      @default(0)
  /// Stock level at which a reorder should be triggered (compared to available stock).
  reorderAt Int
  /// When true, this SKU is sales-tax exempt (common for groceries) — owned by CatalogItem.
  taxExempt Boolean  @default(false)
  /// When this product was first added to the catalog.
  createdAt DateTime @default(now())
  /// When price, stock, or other product fields were last updated.
  updatedAt DateTime @updatedAt

  /// Owning store for this catalog item.
  store     Store      @relation(fields: [storeId], references: [id])
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id])
  /// Line items on sales that referenced this product.
  saleItems SaleItem[]
  /// Audit trail of non-sale stock changes for this product.
  stockAdjustments StockAdjustment[]
  /// Offline sync conflicts that drove this product's stock negative.
  stockReconciliations StockReconciliation[]
  /// Supplier catalog links (case packs / costs) for this SKU.
  supplierProducts SupplierProduct[]
  /// Purchase-order lines that order this product.
  purchaseOrderLines PurchaseOrderLine[]
  /// Goods-receipt lines that received this product into stock.
  goodsReceiptLines GoodsReceiptLine[]
  /// Inventory lots for this product (lot tracking — additive; stock fields unchanged).
  lots Lot[]
  /// Physical count lines for this product.
  stockCountLines StockCountLine[]
  /// Manufacturer UPC/EAN codes and store-printed labels that identify this product at a scanner.
  barcodes ProductBarcode[]

  /// Speeds store-scoped catalog and inventory queries.
  @@index([storeId])
  @@index([catalogItemId])
  /// Two stores may each have "SKU-001"; uniqueness is (storeId, sku).
  @@unique([storeId, sku])
}

/// What kind of code a ProductBarcode is. A UPC/EAN is the manufacturer's (GS1-registered, carries a
/// check digit); a SKU is ours. Store-printed labels usually encode the SKU or an internal code.
enum BarcodeKind {
  /// GS1 GTIN: UPC-A, UPC-E, EAN-8, EAN-13 or GTIN-14 printed by the manufacturer / packer.
  GTIN
  /// Store- or co-op-printed label (shelf tag, produce sticker, FPO crate label without a GTIN).
  INTERNAL
}

/// One scannable code for a product. A product may have several (a can and its case, an old and a
/// new packaging UPC, a store label); a code resolves to exactly one product within a store.
model ProductBarcode {
  id              String      @id @default(cuid())
  /// Denormalised from Product so (storeId, code) can be unique: each store has its own Product row
  /// for the same manufacturer item, so the same UPC legitimately exists once per store.
  storeId         String
  productId       String
  /// Normalized code (see lib/barcode.ts): GTINs are zero-padded to 14 digits so a UPC-A and the
  /// same item's EAN-13 collide here instead of silently registering twice.
  code            String
  kind            BarcodeKind
  /// Free-text hint for staff, e.g. "case of 12" or "old packaging".
  label           String?
  createdByUserId String?
  createdAt       DateTime    @default(now())

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([productId])
}

/// An audited manual change to on-hand stock (shrinkage, recount, receiving correction).
/// Sale-driven decrements do not create these rows — only intentional human adjustments do.
model StockAdjustment {
  /// Primary key uniquely identifying this adjustment event.
  id            String   @id @default(cuid())
  /// Product whose stock was changed.
  productId     String
  /// Store that owns the product (denormalized for store-scoped audit queries).
  storeId       String
  /// User who performed the adjustment (store admin or co-op admin).
  adjustedById  String
  /// On-hand quantity immediately before the adjustment.
  previousStock Int
  /// On-hand quantity after the adjustment was applied.
  newStock      Int
  /// Signed delta for the ledger line. For lot-level adjustments this is the LOT quantity
  /// change (not the Product.stock rollup delta), so quarantined/recalled lot moves are visible.
  delta         Int
  /// Human-readable explanation required for audit (e.g. "cycle count", "damaged goods").
  reason        String
  /// Lot this adjustment applied to (RECEIPT creates a lot; null for pre-lot / non-lot adjustments).
  lotId         String?
  /// Lot.quantityRemaining before the adjustment (null on pre-lot rows).
  lotPreviousQty Int?
  /// Lot.quantityRemaining after the adjustment (null on pre-lot rows).
  lotNewQty      Int?
  /// When the adjustment was recorded.
  createdAt     DateTime @default(now())

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store      Store   @relation(fields: [storeId], references: [id])
  adjustedBy User    @relation("StockAdjustedBy", fields: [adjustedById], references: [id])
  lot        Lot?    @relation(fields: [lotId], references: [id])

  @@index([productId])
  @@index([storeId])
  @@index([adjustedById])
  @@index([lotId])
}

/// Co-op-wide settings (singleton in practice). Voting threshold lives here — never hardcoded.
model CooperativeSettings {
  /// Primary key uniquely identifying this settings row.
  id                    String   @id @default(cuid())
  /// Minimum CONFIRMED capital investment (USD) required before a member may vote.
  /// Threshold lives here, never hardcoded — bylaws can change it by member vote.
  votingThresholdAmount Decimal  @default(1000) @db.Decimal(12, 2)
  /// Fiscal year end month-day (e.g. "12-31") for dividends / reporting.
  fiscalYearEnd         String   @default("12-31")
  /// Legal name of the cooperative entity.
  legalEntityName       String   @default("Harvestlink Cooperative")
  /// US state (or jurisdiction) of incorporation — where the co-op is REGISTERED.
  stateOfIncorporation  String   @default("")
  /// US state code where the co-op OPERATES (may differ from stateOfIncorporation).
  operatingState        String   @default("")
  /// Street address of the principal operating office (where the co-op runs day-to-day).
  principalOfficeAddress String  @default("")
  /// Days a closed shift's cash may sit undeposited before the store is prompted to bank it.
  /// Twice this is the escalation point. Age matters more than amount: cash outside the bank
  /// is at risk from robbery, fire or miscount, and every one of those gets worse with time.
  cashDepositGraceDays  Int      @default(3)
  /// A counted line whose |variance| exceeds this percent of the expected quantity must be
  /// recounted before approval. Either threshold (percent or value) triggers a recount.
  varianceThresholdPercent Decimal @default(10) @db.Decimal(5, 2)
  /// A counted line whose |variance × lot unit cost| exceeds this USD value must be recounted.
  varianceThresholdValue   Decimal @default(25) @db.Decimal(12, 2)
  /// When true, the scheduler creates DRAFT cycle counts on the cadence below.
  cycleCountEnabled        Boolean @default(true)
  /// Days between scheduled cycle counts per store. Class A products are due every cycle.
  cycleCountFrequencyDays  Int     @default(30)
  /// Value on hand (USD at lot cost) at which a product is class A and counted every cycle.
  highValueThreshold       Decimal @default(500) @db.Decimal(12, 2)
  /// Maximum products in one cycle count.
  cycleCountSize           Int     @default(20)
  /// Location that receives containers (Phase 2) and supplies stores (Phase 3). Must be a WAREHOUSE.
  mainWarehouseId       String?
  /// When this settings row was created.
  createdAt             DateTime @default(now())
  /// When settings were last updated.
  updatedAt             DateTime @updatedAt

  mainWarehouse Store? @relation("MainWarehouse", fields: [mainWarehouseId], references: [id])
}

/// The one-time joining fee that makes someone a member. Confers NO voting rights.
/// Confirm with the co-op's accountant whether this is revenue or member capital.
model MembershipFee {
  /// Primary key uniquely identifying this fee payment.
  id                String              @id @default(cuid())
  /// Member who owes / paid this joining fee.
  memberId          String
  /// Joining fee amount (USD). Default $100 per harvestlinx.com/membership.
  amount            Decimal             @default(100) @db.Decimal(12, 2)
  /// How the fee was paid (cash, check, card, ACH, etc.).
  paymentMethod     String              @default("")
  /// External reference (check number, Stripe id, etc.).
  paymentReference  String?
  /// PENDING → CONFIRMED / FAILED.
  paymentStatus     MembershipFeeStatus @default(PENDING)
  /// When funds were received (null while PENDING).
  paidAt            DateTime?
  /// Admin who confirmed receipt.
  confirmedByUserId String?
  /// When an admin confirmed the fee.
  confirmedAt       DateTime?
  /// When this row was created.
  createdAt         DateTime            @default(now())

  member      Member @relation(fields: [memberId], references: [id])
  confirmedBy User?  @relation("MembershipFeeConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@index([memberId])
  @@index([paymentStatus])
  @@index([confirmedByUserId])
}

/// A configurable member perk (network-wide — not tied to a dollar tier).
/// Benefits are VERSIONED, never overwritten. Members are owners who paid for life and cannot
/// cancel like subscribers, so the record of what was promised and when must survive. To change
/// a benefit, set endsAt on the old row and create a new one.
model MemberBenefit {
  /// Primary key uniquely identifying this benefit version.
  id                     String         @id @default(cuid())
  /// Kind of perk (percent off, free delivery, exclusive SKU, etc.).
  benefitType            BenefitType
  /// Numeric magnitude for the perk (e.g. 5.00 = 5% or $5 depending on benefitType).
  value                  Decimal        @db.Decimal(12, 4)
  /// Catalog / network breadth of this perk.
  scope                  BenefitScope
  /// Category id, product id, or store id when scope is CATEGORY / PRODUCT / STORE; null otherwise.
  scopeRefId             String?
  /// When this benefit version becomes effective.
  startsAt               DateTime       @default(now())
  /// When this benefit version stops (null = indefinite / still current).
  endsAt                 DateTime?
  /// Max times a member may use this benefit in one period (null = unlimited).
  maxUsesPerPeriod       Int?
  /// Cap window for maxUsesPerPeriod (transaction / day / month / year / lifetime).
  periodType             BenefitPeriod  @default(PER_TRANSACTION)
  /// Minimum pre-discount purchase (USD) required before this benefit can apply.
  minimumPurchaseAmount  Decimal        @default(0) @db.Decimal(12, 2)
  /// Soft flag; prefer ending a version via endsAt rather than flipping false in place.
  isActive               Boolean        @default(true)
  /// Evaluation order when multiple benefits could apply (lower = earlier / higher priority).
  priority               Int            @default(100)
  /// Human-readable explanation shown in admin / member communications.
  description            String         @default("")
  /// Co-op admin (User) who created this benefit version.
  createdByUserId        String
  /// When this benefit version row was created.
  createdAt              DateTime       @default(now())
  /// When this row was last updated (metadata only — do not overwrite value/scope in place).
  updatedAt              DateTime       @updatedAt

  createdBy User                 @relation("MemberBenefitCreatedBy", fields: [createdByUserId], references: [id])
  usages    MemberBenefitUsage[]
  /// Sale lines that applied this benefit version (historical — never rewrite).
  saleItems SaleItem[]

  @@index([isActive, startsAt, endsAt])
  @@index([benefitType])
  @@index([priority])
  @@index([createdByUserId])
}

/// One application of a MemberBenefit on a Sale for a Member.
/// Enforces usage caps AND answers "what are our member perks actually costing the co-op?"
model MemberBenefitUsage {
  /// Primary key uniquely identifying this usage event.
  id          String   @id @default(cuid())
  /// Member who received the perk on this sale.
  memberId    String
  /// Benefit version that was applied.
  benefitId   String
  /// Sale on which the perk was applied.
  saleId      String
  /// Dollar amount saved / cost of the perk on this sale (USD).
  amountSaved Decimal  @db.Decimal(12, 2)
  /// When the perk was applied (checkout time).
  usedAt      DateTime @default(now())

  member  Member        @relation(fields: [memberId], references: [id])
  benefit MemberBenefit @relation(fields: [benefitId], references: [id])
  sale    Sale          @relation(fields: [saleId], references: [id])

  /// Fast cap checks during checkout: count usages for (member, benefit) in a time window.
  @@index([memberId, benefitId, usedAt])
  @@index([saleId])
  @@index([benefitId])
}

/// A co-op member-OWNER. Membership NEVER expires. Soft status changes only — never hard-delete.
model Member {
  /// Primary key uniquely identifying this member.
  id                      String       @id @default(cuid())
  /// Co-op-wide membership / card number (POS hot-path lookup; keep indexed).
  memberNumber            String       @unique
  /// Legal name for certificates, dividends, and tax forms.
  name                    String
  /// Contact email (receipts, dividend notices).
  email                   String
  /// Contact phone for member services and certificate delivery.
  phone                   String       @default("")
  /// Mailing address for equity certificates and tax forms (1099).
  mailingAddress          String       @default("")
  /// Owner lifecycle (PENDING → ACTIVE → soft exit). Never hard-delete members.
  status                  MemberStatus @default(PENDING)
  /// When the member record was created (application / join date).
  joinedAt                DateTime     @default(now())
  /// User who approved this member into ACTIVE status (board / co-op admin).
  approvedByUserId        String?
  /// When membership was approved / activated (null while PENDING).
  approvedAt              DateTime?
  /// Last 4 of SSN/ITIN for dividend tax reporting — encrypted at rest by membership.service
  /// (AES-GCM). 1099-PATR vs 1099-DIV classification must be confirmed with the co-op accountant.
  taxIdLast4              String?
  /// Soft eligibility flag (board can suspend voting for other reasons). Actual ballot rights
  /// require hasVotingRights = true (capital threshold). Prefer checking hasVotingRights.
  isEligibleToVote        Boolean      @default(true)
  /// Rollup of CONFIRMED CapitalInvestment amounts only (excludes PENDING / FAILED / REFUNDED).
  /// Recomputed whenever a CapitalInvestment is CONFIRMED or refunded.
  totalInvested           Decimal      @default(0) @db.Decimal(12, 2)
  /// A member votes ONLY if totalInvested >= CooperativeSettings.votingThresholdAmount.
  /// Above the threshold every voting member gets EXACTLY ONE vote, whether they invested $1,000
  /// or $50,000. Investing more buys more dividend participation, never more votes.
  /// One member, one vote AMONG MEMBERS WITH VOTING RIGHTS.
  /// Recomputed whenever a CapitalInvestment is CONFIRMED or refunded.
  hasVotingRights         Boolean      @default(false)
  /// Optional household primary: secondary shopper cards linked under one voting owner.
  householdPrimaryMemberId String?

  approvedBy      User?            @relation("MemberApprovedBy", fields: [approvedByUserId], references: [id])
  householdPrimary Member?         @relation("MemberHousehold", fields: [householdPrimaryMemberId], references: [id])
  householdMembers Member[]        @relation("MemberHousehold")
  sales            Sale[]
  /// One-time joining fees (MembershipFee — confers NO votes).
  membershipFees   MembershipFee[]
  /// Equity stakes for this owner (CapitalInvestment — never sales revenue).
  investments      CapitalInvestment[]
  /// Running capital account (total in / distributed / balance).
  equityAccount    MemberEquityAccount?
  /// Per-dividend payout lines for this member.
  dividendAllocations DividendAllocation[]
  votes            MemberVote[]
  /// Checkout applications of MemberBenefit for this owner (cap + cost tracking).
  benefitUsages  MemberBenefitUsage[]
  /// Recall outreach rows for this member (regulatory retention — never delete).
  recallNotifications RecallNotification[]

  @@index([memberNumber])
  @@index([status])
  @@index([email])
  @@index([approvedByUserId])
  @@index([householdPrimaryMemberId])
  @@index([hasVotingRights])
}

/// A capital investment (equity stake). EQUITY — never revenue, never part of store sales or
/// operator settlement. Amount is VARIABLE (a $1,000 minimum for voting; someone may invest $5,000).
/// Must NEVER appear in sales reports, store revenue, operator settlement, or P&L.
/// Operators earn NO percentage. Routed only through membership.service — never createSale.
/// Additional investments ADD rows; never replace prior investments.
/// Dividend weight uses totalInvested; voting is binary (hasVotingRights) — never weighted.
model CapitalInvestment {
  /// Primary key uniquely identifying this investment.
  id                     String               @id @default(cuid())
  /// Member who made this equity investment.
  memberId               String
  /// Amount invested (USD). Variable — may exceed the voting threshold.
  amount                 Decimal              @db.Decimal(12, 2)
  /// How the investment was paid (cash, check, card, ACH, wire, etc.).
  paymentMethod          String               @default("")
  /// External reference (check number, Stripe id, wire confirmation, etc.).
  paymentReference       String?
  /// Payment lifecycle for this equity payment.
  paymentStatus          CapitalPaymentStatus @default(PENDING)
  /// Stripe PaymentIntent id when collected via card (optional; cash/check also allowed).
  stripePaymentIntentId  String?              @unique
  /// Admin who confirmed receipt of funds.
  confirmedByUserId      String?
  /// URL / path to signed subscription (equity purchase) agreement.
  subscriptionAgreementUrl String?
  /// When funds were confirmed received (CONFIRMED status).
  receivedAt             DateTime?
  /// Printed equity certificate number (human-readable).
  certificateNumber      String?              @unique
  /// When this investment was refunded (withdrawal).
  refundedAt             DateTime?
  /// When the investment row was created.
  createdAt              DateTime             @default(now())

  member      Member @relation(fields: [memberId], references: [id])
  confirmedBy User?  @relation("CapitalInvestmentConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@index([memberId])
  @@index([paymentStatus])
  @@index([confirmedByUserId])
}

/// Running equity ledger for a member (derived from CapitalInvestment + DividendAllocation).
model MemberEquityAccount {
  /// Primary key uniquely identifying this equity account.
  id                 String   @id @default(cuid())
  /// Owner of this equity account (one per member).
  memberId           String   @unique
  /// Sum of CONFIRMED (non-refunded) capital investments.
  totalContributed   Decimal  @default(0) @db.Decimal(12, 2)
  /// Cumulative dividends paid/allocated to date.
  distributedToDate  Decimal  @default(0) @db.Decimal(12, 2)
  /// currentBalance = totalContributed − distributedToDate (simplified equity book).
  currentBalance     Decimal  @default(0) @db.Decimal(12, 2)
  /// When totals were last recomputed.
  lastUpdatedAt      DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])
}

/// Board action authorizing dividends or other co-op decisions (minutes link).
model BoardResolution {
  /// Primary key uniquely identifying this resolution.
  id          String                  @id @default(cuid())
  /// Short title for the resolution.
  title       String
  /// Full text / description of what the board resolved.
  description String                  @default("")
  /// When the resolution was proposed.
  proposedAt  DateTime                @default(now())
  /// When the board voted (null while pending).
  votedAt     DateTime?
  /// Outcome of the board vote.
  outcome     BoardResolutionOutcome  @default(PENDING)
  /// URL to meeting minutes / PDF.
  minutesUrl  String?
  /// When this row was created.
  createdAt   DateTime                @default(now())

  dividends Dividend[]
}

/// A declared dividend pool. REQUIRES a BoardResolution — cannot be created without one.
model Dividend {
  /// Primary key uniquely identifying this dividend declaration.
  id                 String                    @id @default(cuid())
  /// Authorizing board resolution (required).
  boardResolutionId  String
  /// Fiscal year the dividend relates to (e.g. 2026).
  fiscalYear         Int
  /// Total pool amount to allocate across members.
  totalPoolAmount    Decimal                   @db.Decimal(12, 2)
  /// How to split the pool (BY_CAPITAL / BY_PATRONAGE / HYBRID) — see enum comment.
  allocationMethod   DividendAllocationMethod
  /// When the dividend was declared.
  declaredAt         DateTime                  @default(now())
  /// When payments were marked paid (null until paid).
  paidAt             DateTime?
  /// Lifecycle of this dividend run.
  status             DividendStatus            @default(DECLARED)

  boardResolution BoardResolution     @relation(fields: [boardResolutionId], references: [id])
  allocations     DividendAllocation[]

  @@index([boardResolutionId])
  @@index([fiscalYear])
  @@index([status])
}

/// Per-member share of a Dividend.
/// Tax form issuance: 1099-PATR vs 1099-DIV depends on whether the distribution is classified
/// as patronage dividend vs investment return — MUST be confirmed with the co-op's accountant
/// before setting taxFormIssued; Harvestlink stores the flag, not the legal classification.
model DividendAllocation {
  /// Primary key uniquely identifying this allocation line.
  id              String               @id @default(cuid())
  /// Parent dividend declaration.
  dividendId      String
  /// Member receiving this allocation.
  memberId        String
  /// Weight used in the allocation formula (capital, patronage dollars, or hybrid blend).
  memberWeight    Decimal              @db.Decimal(18, 6)
  /// Dollar amount allocated to this member.
  amount          Decimal              @db.Decimal(12, 2)
  /// Whether this allocation has been paid out.
  paymentStatus   CapitalPaymentStatus @default(PENDING)
  /// Whether a tax form was issued for this allocation (see accountant note above).
  taxFormIssued   Boolean              @default(false)

  dividend Dividend @relation(fields: [dividendId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id])

  @@unique([dividendId, memberId])
  @@index([memberId])
}

/// A co-op ballot (election / referendum). One vote per ACTIVE member — never weighted by capital.
model Ballot {
  /// Primary key uniquely identifying this ballot.
  id          String       @id @default(cuid())
  /// Ballot title shown to voters.
  title       String
  /// Description / question text.
  description String       @default("")
  /// When voting opens.
  opensAt     DateTime     @default(now())
  /// When voting closes (null = open until closed manually).
  closesAt    DateTime?
  /// OPEN / CLOSED / CANCELLED.
  status      BallotStatus @default(OPEN)
  /// When this ballot was created.
  createdAt   DateTime     @default(now())

  options BallotOption[]
  votes   MemberVote[]
}

/// A selectable option on a Ballot.
model BallotOption {
  /// Primary key uniquely identifying this option.
  id       String @id @default(cuid())
  /// Parent ballot.
  ballotId String
  /// Option label (e.g. "Yes", "Candidate A").
  label    String
  /// Display order (ascending).
  sortOrder Int   @default(0)

  ballot Ballot       @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  votes  MemberVote[]

  @@index([ballotId])
}

/// One member's vote on a ballot. Unique (ballotId, memberId) enforces one-member-one-vote at DB level.
model MemberVote {
  /// Primary key uniquely identifying this vote.
  id             String   @id @default(cuid())
  /// Ballot being voted on.
  ballotId       String
  /// Voting member (must be ACTIVE + hasVotingRights; soft isEligibleToVote also checked).
  memberId       String
  /// Option selected.
  ballotOptionId String
  /// When the vote was cast.
  castAt         DateTime @default(now())

  ballot Ballot       @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  member Member       @relation(fields: [memberId], references: [id])
  option BallotOption @relation(fields: [ballotOptionId], references: [id])

  /// HARD RULE: one member, one vote — never weight by contribution size.
  @@unique([ballotId, memberId])
  @@index([memberId])
  @@index([ballotOptionId])
}

/// A completed (or in-progress) checkout transaction; settlement amounts are frozen at sale time.
///
/// MONEY FLOW (Stripe vs internal ledger):
/// - Stripe payouts should land in the CO-OP Stripe account (the co-op is the merchant of record).
/// - Sale.operatorAmount / Phase 6 Payout rows are a SEPARATE internal ledger: they track what the
///   co-op owes the store operator. They are NOT Stripe Connect/destination charges to the operator.
///   The co-op decides when to actually pay the operator (e.g. weekly bank transfer) via /settlement.
model Sale {
  /// Primary key uniquely identifying this sale.
  id              String   @id @default(cuid())
  /// Store where the sale was rung up.
  storeId         String
  /// Cashier (User) who completed the sale.
  cashierId       String
  /// Optional member attached to the sale when a member number was provided.
  memberId        String?
  /// Line totals before any member benefit (and before manual discounts) — frozen at checkout.
  /// Later benefit edits must never change this snapshot.
  subtotalBeforeDiscount Decimal @db.Decimal(12, 2)
  /// Sum of line nets after discounts, BEFORE sales tax.
  /// Operator share is computed from this field — never from post-tax total.
  subtotal        Decimal  @db.Decimal(12, 2)
  /// Total discounts applied (benefit + manual). Member capital is NOT a discount.
  discountAmount  Decimal  @default(0) @db.Decimal(12, 2)
  /// Total member-benefit discount on this sale (excludes manual admin discounts). Snapshotted.
  memberDiscountAmount Decimal @default(0) @db.Decimal(12, 2)
  /// Who funded memberDiscountAmount at sale time (from Store settings — never re-read later).
  memberDiscountBearer DiscountBearer @default(COOP)
  /// Sales tax charged on non-exempt lines (remitted to the state — not operator revenue).
  taxAmount       Decimal  @default(0) @db.Decimal(12, 2)
  /// Amount charged to the customer: subtotal + taxAmount.
  total           Decimal  @db.Decimal(12, 2)
  /// Snapshot of the store's operatorPercent at sale time — never recalculate historical sales from later store settings.
  operatorPercent Decimal  @db.Decimal(5, 2)
  /// Operator's earned share = operatorBaseSnapshot × operatorPercent (PRE-TAX).
  /// Tax is excluded because it is remitted to the state and is not store revenue.
  /// Internal ledger only — not a Stripe transfer to the operator.
  operatorAmount  Decimal  @db.Decimal(12, 2)
  /// The pre-tax base the operator share was actually computed from, determined by
  /// memberDiscountBearer at sale time. Refund proration MUST divide by this, not by subtotal —
  /// under COOP bearer they are different numbers. Nullable for sales created before this field
  /// existed; those fall back to subtotal.
  operatorBaseSnapshot Decimal? @db.Decimal(12, 2)
  /// Co-op share of pre-tax subtotal after operator accrual (subtotal − operatorAmount).
  coopAmount      Decimal  @db.Decimal(12, 2)
  /// Card payment lifecycle; physical stock decrements only when PAID.
  /// PENDING sales hold Product.reserved until paid, failed, refunded-from-pending, or expired.
  /// CASH sales are created already PAID (no Stripe, no reservation hold).
  paymentStatus   PaymentStatus @default(PENDING)
  /// Payment channel: TERMINAL / CHECKOUT (Stripe) or CASH (drawer).
  paymentMethod   PaymentMethod?
  /// Last 4 digits of card when paid via Stripe (null for cash).
  cardLast4       String?
  /// Stripe PaymentIntent id (Terminal and often Checkout's underlying intent).
  stripePaymentIntentId String? @unique
  /// Stripe Checkout Session id when paymentMethod = CHECKOUT.
  stripeCheckoutSessionId String? @unique
  /// Cumulative customer $ refunded via Stripe (full or partial).
  refundedAmount Decimal @default(0) @db.Decimal(12, 2)
  /// Cumulative operator share clawed back so settlement does not overpay on refunds.
  refundedOperatorAmount Decimal @default(0) @db.Decimal(12, 2)
  /// In-flight SaleRefund id while paymentStatus = REFUNDING (for reconciliation).
  pendingRefundId String?
  /// When Stripe reported successful payment and stock was finalized (or cash taken).
  paidAt          DateTime?
  /// When the sale was fully refunded (all line qty returned).
  refundedAt      DateTime?
  /// When the PENDING stock reservation expires if payment never completes (cleanup job).
  reservationExpiresAt DateTime?
  /// Client-generated key for offline / retry-safe checkout. Unique globally so a
  /// replayed POST /sales never creates a second Sale (double stock decrement / charge).
  idempotencyKey String? @unique
  /// When the sale record was created (may be PENDING before payment).
  createdAt       DateTime @default(now())

  /// Store that recorded this sale.
  store    Store      @relation(fields: [storeId], references: [id])
  /// Cashier who processed the sale.
  cashier  User       @relation("SaleCashier", fields: [cashierId], references: [id])
  /// Member on the sale, if any.
  member   Member?    @relation(fields: [memberId], references: [id])
  /// Line items that make up this sale.
  items    SaleItem[]
  /// Refund attempts (including in-flight REFUNDING rows).
  refunds  SaleRefund[]
  /// Stock conflicts created when this (typically offline) sale drove inventory negative.
  stockReconciliations StockReconciliation[]
  /// Member benefit applications recorded against this checkout (cost + cap tracking).
  benefitUsages MemberBenefitUsage[]

  /// Speeds store sales reporting and settlement queries.
  @@index([storeId])
  @@index([cashierId])
  /// Recall contact expansion: sales → member (name/email/phone/mailingAddress).
  @@index([memberId])
  /// Forward recall filters PAID/REFUNDED/REFUNDING sales; expiry job uses PENDING + reservationExpiresAt.
  @@index([paymentStatus])
  /// Cleanup job finds expired PENDING reservations via this index.
  @@index([reservationExpiresAt])
  /// Store-scoped recall / settlement: filter by store then payment status in one pass.
  @@index([storeId, paymentStatus])
}

/// A single line on a sale; product name/price/SKU are snapshotted so history stays accurate after catalog changes.
model SaleItem {
  /// Primary key uniquely identifying this sale line.
  id            String  @id @default(cuid())
  /// Parent sale this line belongs to.
  saleId        String
  /// Product that was sold (kept for inventory/history links even if catalog fields change).
  productId     String
  /// SKU as it appeared at sale time (survives later SKU edits).
  skuSnapshot   String
  /// Product name as it appeared at sale time (survives later renames).
  nameSnapshot  String
  /// Unit price charged at sale time (survives later reprices).
  priceSnapshot Decimal @db.Decimal(12, 2)
  /// Quantity of units sold on this line.
  quantity      Int
  /// TOTAL line discount (benefit + manual), before tax.
  /// The existing discountAmount field stays as the TOTAL line discount (benefit + manual).
  /// benefitDiscountAmount isolates the benefit portion for reporting.
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  /// MemberBenefit version applied to this line (null if none). Snapshotted — never rewritten.
  benefitId     String?
  /// Benefit portion of this line's discount (USD). Manual discounts are discountAmount − this.
  benefitDiscountAmount Decimal @default(0) @db.Decimal(12, 2)
  /// Optional reason when a STORE_ADMIN applied a manual line discount.
  discountReason String?
  /// Sales tax for this line (0 when taxExempt at sale time).
  taxAmount     Decimal @default(0) @db.Decimal(12, 2)
  /// Whether this line was tax-exempt when sold (snapshot).
  taxExempt     Boolean @default(false)
  /// Units already refunded on this line (partial refunds accumulate here).
  refundedQuantity Int @default(0)

  /// Parent sale transaction.
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  /// Catalog product referenced by this line.
  product Product @relation(fields: [productId], references: [id])
  /// Benefit version applied to this line at sale time (null if none).
  benefit MemberBenefit? @relation(fields: [benefitId], references: [id])
  /// Refund line allocations against this item.
  refundLines SaleRefundLine[]
  /// Lot allocations for this line (FEFO; one row per lot when a line spans lots).
  lotAllocations SaleItemLot[]
  /// Per-lot restock rows from refunds that returned units for this line.
  refundRestocks RefundRestockLot[]

  @@index([saleId])
  @@index([productId])
  @@index([benefitId])
}

/// Which lot(s) fulfilled a SaleItem, and at what unit cost.
/// One SaleItem may have several rows when a line spans lots (FEFO split).
/// unitCostSnapshot freezes lot cost at sale time — the same snapshot discipline already used
/// for price and operatorPercent. This is what makes historical margin accurate.
model SaleItemLot {
  /// Primary key uniquely identifying this allocation row.
  id               String  @id @default(cuid())
  /// Parent sale line.
  saleItemId       String
  /// Lot that supplied these units.
  lotId            String
  /// Units taken from this lot for the sale line.
  quantity         Int
  /// Lot.unitCost frozen at sale time (margin / COGS). 4 dp; line money stays 2 dp.
  unitCostSnapshot Decimal @db.Decimal(14, 4)

  saleItem SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  lot      Lot      @relation(fields: [lotId], references: [id])

  /// Backward trace: sale line → lot allocations that fulfilled it.
  @@index([saleItemId])
  /// Forward recall: lot → every sale allocation. Must stay indexed — incomplete customer lists are the failure mode that matters.
  @@index([lotId])
  /// Covering pair for forward join SaleItemLot → SaleItem without heap lookups on the allocation row.
  @@index([lotId, saleItemId])
}

/// Status of a SaleRefund attempt (DB-first refund protocol).
enum SaleRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// A refund attempt against a Sale — claimed in DB before Stripe.refunds.create.
model SaleRefund {
  /// Primary key for this refund attempt.
  id              String          @id @default(cuid())
  /// Parent sale being refunded.
  saleId          String
  /// Customer-facing refund amount (cents settle via Stripe).
  amount          Decimal         @db.Decimal(12, 2)
  /// Operator share clawed back for settlement (proportional to refunded lines).
  operatorAmount  Decimal         @db.Decimal(12, 2)
  /// When true, restock sellable inventory; when false, record a write-off instead.
  restock         Boolean         @default(true)
  /// Lifecycle of this attempt (PENDING while Stripe call in flight).
  status          SaleRefundStatus @default(PENDING)
  /// Stripe refund id once created (reconciliation key).
  stripeRefundId  String?         @unique
  /// Who initiated the refund.
  createdByUserId String?
  /// When the attempt was created (sale moved to REFUNDING).
  createdAt       DateTime        @default(now())
  /// When the attempt reached SUCCEEDED or FAILED.
  completedAt     DateTime?

  sale  Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  lines SaleRefundLine[]
  writeOffs InventoryWriteOff[]
  restockLots RefundRestockLot[]

  @@index([saleId])
  @@index([status])
}

/// Per-lot record of units returned to inventory on a restocking refund.
/// restockToLots moves quantity; this table is the auditable trail of which lot got how many,
/// at the SaleItemLot unitCostSnapshot being reversed (including QUARANTINED lots).
model RefundRestockLot {
  id               String   @id @default(cuid())
  saleRefundId     String
  saleItemId       String
  lotId            String
  quantity         Int
  /// SaleItemLot.unitCostSnapshot for the units being returned.
  unitCostSnapshot Decimal  @db.Decimal(14, 4)
  createdAt        DateTime @default(now())

  saleRefund SaleRefund @relation(fields: [saleRefundId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])
  lot        Lot        @relation(fields: [lotId], references: [id])

  @@index([lotId])
  @@index([saleRefundId])
}

/// Line-level allocation within a SaleRefund (supports partial item refunds).
model SaleRefundLine {
  id          String @id @default(cuid())
  saleRefundId String
  saleItemId  String
  /// Units of this SaleItem included in the refund.
  quantity    Int

  saleRefund SaleRefund @relation(fields: [saleRefundId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])

  @@index([saleRefundId])
  @@index([saleItemId])
}

/// Audit row when inventory leaves sellable stock without a normal sale.
/// Refund path: restock=false (sale / saleRefundId set). Expiry job: reason EXPIRED (lotId set).
model InventoryWriteOff {
  id           String   @id @default(cuid())
  storeId      String
  productId    String
  /// Lot written off (expiry / quarantine disposition); null for legacy refund-only rows.
  lotId        String?
  /// Sale that triggered the write-off; null for non-sale write-offs (e.g. lot expiry).
  saleId       String?
  saleItemId   String?
  saleRefundId String?
  quantity     Int
  reason       String
  /// Lot unit cost at write-off time; null on rows written before valuation was recorded.
  unitCost     Decimal? @db.Decimal(14, 4)
  /// quantity × unitCost (rounded to 2 dp); null on rows written before valuation was recorded.
  value        Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  saleRefund SaleRefund? @relation(fields: [saleRefundId], references: [id], onDelete: Cascade)
  lot        Lot?        @relation(fields: [lotId], references: [id])

  @@index([storeId])
  @@index([productId])
  @@index([saleRefundId])
  @@index([lotId])
}

/// A record of money actually paid from the co-op account to a store operator.
model Payout {
  /// Primary key uniquely identifying this payout.
  id           String   @id @default(cuid())
  /// Store whose operator received this payout.
  storeId      String
  /// Amount paid out to the operator from the co-op account.
  amount       Decimal  @db.Decimal(12, 2)
  /// Optional note describing the payout period or payment method.
  note         String?
  /// Co-op user who recorded / authorized this payout.
  paidByUserId String
  /// When the payout was recorded.
  createdAt    DateTime @default(now())

  /// Store associated with the operator being paid.
  store  Store @relation(fields: [storeId], references: [id])
  /// User who marked this payout as paid.
  paidBy User  @relation("PayoutPaidBy", fields: [paidByUserId], references: [id])

  /// Speeds store payout history and operator settlement reports.
  @@index([storeId])
  @@index([paidByUserId])
}

/// In-store cash drawer shift. Exactly one may be open (closedAt null) per store.
model CashDrawer {
  id              String    @id @default(cuid())
  storeId         String
  openedByUserId  String
  closedByUserId  String?
  /// Cash in the drawer when the shift opened.
  openingFloat    Decimal   @db.Decimal(12, 2)
  /// openingFloat + net cash sales during the open window (set at close; 0 while open).
  expectedCash    Decimal   @default(0) @db.Decimal(12, 2)
  /// Physical count entered when closing.
  countedCash     Decimal?  @db.Decimal(12, 2)
  /// countedCash − expectedCash (set at close).
  variance        Decimal?  @db.Decimal(12, 2)
  openedAt        DateTime  @default(now())
  closedAt        DateTime?

  store    Store @relation(fields: [storeId], references: [id])
  openedBy User  @relation("DrawerOpenedBy", fields: [openedByUserId], references: [id])
  closedBy User? @relation("DrawerClosedBy", fields: [closedByUserId], references: [id])
  /// Deposits that claim to bank this shift's cash.
  depositLinks CashDepositDrawer[]

  @@index([storeId])
  @@index([storeId, closedAt])
}

/// Lifecycle of a cash deposit. Only CONFIRMED deposits count as banked.
enum CashDepositStatus {
  RECORDED
  CONFIRMED
  DISPUTED
}

/// Cash taken from a store's tills to the bank.
/// An operator RECORDS a deposit; a co-op admin CONFIRMS it against the bank statement. Same
/// discipline as membership payment claims: someone saying money moved and money actually
/// arriving are two different events, and only the second one counts.
/// Never deleted — a wrong deposit is DISPUTED and a corrected one recorded in its place.
model CashDeposit {
  id                String            @id @default(cuid())
  storeId           String
  depositedByUserId String
  /// Amount the operator says they banked.
  amount            Decimal           @db.Decimal(12, 2)
  depositedAt       DateTime          @default(now())
  /// Bank statement reference; null until a co-op admin confirms.
  bankReference     String?
  depositSlipUrl    String?
  status            CashDepositStatus @default(RECORDED)
  /// Amount the bank statement actually shows. Always trust this over `amount`.
  confirmedAmount   Decimal?          @db.Decimal(12, 2)
  confirmedByUserId String?
  confirmedAt       DateTime?
  disputedByUserId  String?
  disputedAt        DateTime?
  disputeReason     String?
  notes             String?
  createdAt         DateTime          @default(now())

  store       Store               @relation(fields: [storeId], references: [id])
  depositedBy User                @relation("CashDepositDepositedBy", fields: [depositedByUserId], references: [id])
  confirmedBy User?               @relation("CashDepositConfirmedBy", fields: [confirmedByUserId], references: [id])
  disputedBy  User?               @relation("CashDepositDisputedBy", fields: [disputedByUserId], references: [id])
  drawers     CashDepositDrawer[]

  @@index([storeId, status])
  @@index([depositedAt])
}

/// Which closed shifts a deposit covers. A deposit may cover several days; a single very large
/// shift may be split across deposits.
model CashDepositDrawer {
  depositId    String
  cashDrawerId String

  deposit    CashDeposit @relation(fields: [depositId], references: [id])
  cashDrawer CashDrawer  @relation(fields: [cashDrawerId], references: [id])

  @@id([depositId, cashDrawerId])
  @@index([cashDrawerId])
}

/// Offline / sync inventory conflicts awaiting human review.
///
/// When a cash sale queued during an outage is replayed and physical stock is already
/// gone (another till sold it online), we still ACCEPT the sale — the goods left the
/// store in the cashier's hands. Stock may go negative; this row flags that skew so
/// ops can recount / adjust rather than silently dropping a real transaction.
model StockReconciliation {
  id            String    @id @default(cuid())
  storeId       String
  saleId        String
  productId     String
  /// Units sold on the conflicting line.
  quantitySold  Int
  /// Product.stock immediately before this sale's decrement.
  stockBefore   Int
  /// Product.stock after decrement (often negative).
  stockAfter    Int
  /// Stable reason code (e.g. OFFLINE_SALE_NEGATIVE_STOCK).
  reason        String
  resolvedAt    DateTime?
  resolvedByUserId String?
  notes         String?
  createdAt     DateTime  @default(now())

  store   Store   @relation(fields: [storeId], references: [id])
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([storeId])
  @@index([storeId, resolvedAt])
  @@index([saleId])
  @@index([productId])
}

/// Lifecycle of a purchase order from draft through receiving.
enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// How the co-op classifies a vendor in the network catalog.
enum SupplierType {
  FPO
  EXPORTER
  DOMESTIC_DISTRIBUTOR
  DOMESTIC_VENDOR
  OTHER
}

/// Legal form of an Indian Farmer Producer Organisation (on FpoProfile).
enum FpoLegalForm {
  PRODUCER_COMPANY
  COOPERATIVE_SOCIETY
  OTHER
}

/// Organic claim at the cluster / SourcingOrigin level — never named-farmer PII.
enum OrganicStatus {
  CONVENTIONAL
  IN_CONVERSION
  CERTIFIED_ORGANIC
}

/// Lifecycle of an ocean/air import container from planning through landed-cost close.
enum ImportShipmentStatus {
  PLANNED
  BOOKED
  IN_TRANSIT
  AT_PORT
  CUSTOMS_HOLD
  CLEARED
  DELIVERED
  RECEIVED
  COSTED
  CLOSED
  CANCELLED
}

/// How goods move on an import shipment.
enum ShipmentMode {
  SEA_FCL
  SEA_LCL
  AIR
}

/// Incoterm governing risk/cost split with the overseas seller.
enum Incoterm {
  FOB
  CIF
  CFR
  EXW
  DAP
}

/// Landed-cost line kinds allocated onto an import shipment.
enum ShipmentCostType {
  OCEAN_FREIGHT
  AIR_FREIGHT
  INSURANCE
  CUSTOMS_DUTY
  BROKER_FEE
  PORT_CHARGES
  DRAYAGE
  INLAND_FREIGHT
  FDA_EXAM
  STORAGE_DEMURRAGE
  FX_DIFFERENCE
  OTHER
}

/// How a ShipmentCost is spread across shipment lines / PO value.
enum CostAllocationBasis {
  VALUE
  WEIGHT
  VOLUME
  QUANTITY
  LINE_SPECIFIC
}

/// Whether a ShipmentCost row is a working estimate or a final invoice.
enum ShipmentCostStatus {
  ESTIMATED
  FINAL
}

/// Why a LandedCostVariance row was recognised.
enum LandedCostVarianceReason {
  /// COGS already consumed, booked in the period of the shipment true-up.
  TRUE_UP
  /// Undo true-up COGS when units return to a lot that was trued-up after the sale.
  RESTOCK_REVERSAL
}

/// Supplier food-import / organic / facility certification kinds.
enum CertificationType {
  FSSAI_LICENSE
  APEDA_RCMC
  FDA_FOOD_FACILITY_REGISTRATION
  ORGANIC_NPOP
  ORGANIC_USDA
  FSVP_VERIFICATION
  LAB_ACCREDITATION
  OTHER
}

/// Paperwork kinds commonly required for US food imports (broker confirms per product).
enum ShipmentDocType {
  COMMERCIAL_INVOICE
  PACKING_LIST
  BILL_OF_LADING
  AIR_WAYBILL
  CERTIFICATE_OF_ORIGIN
  PHYTOSANITARY_CERTIFICATE
  FDA_PRIOR_NOTICE
  CUSTOMS_ENTRY_SUMMARY
  LAB_REPORT
  FUMIGATION_CERTIFICATE
  INSURANCE_CERTIFICATE
  OTHER
}

/// Vendor that sells goods to the co-op / stores (network-wide; not store-scoped).
model Supplier {
  /// Primary key uniquely identifying this supplier.
  id            String   @id @default(cuid())
  /// Legal / trade name shown on POs and receiving screens.
  name          String
  /// Primary contact person at the vendor.
  contactName   String   @default("")
  /// Vendor billing / order email.
  email         String   @default("")
  /// Vendor phone for order follow-up.
  phone         String   @default("")
  /// Mailing / remit-to address.
  address       String   @default("")
  /// Payment terms string (e.g. NET30, COD, NET15).
  paymentTerms  String   @default("NET30")
  /// Typical days from order submit to delivery (used for expectedDate suggestions).
  leadTimeDays  Int      @default(7)
  /// When false, supplier cannot be selected on new POs.
  isActive      Boolean  @default(true)
  /// Free-form ops notes (dock hours, pallet requirements, etc.).
  notes         String   @default("")
  /// FPO / exporter / domestic distributor / etc. Default is a US domestic vendor.
  supplierType  SupplierType @default(DOMESTIC_VENDOR)
  /// ISO country code for the supplier's domicile (default US).
  country       String   @default("US")
  /// When this supplier record was created.
  createdAt     DateTime @default(now())
  /// When supplier fields were last updated.
  updatedAt     DateTime @updatedAt

  /// Catalog links from this supplier to store products.
  products       SupplierProduct[]
  /// Purchase orders placed with this supplier.
  purchaseOrders PurchaseOrder[]
  /// Inventory lots sourced from this supplier (null on Lot when unknown / legacy).
  /// When an exporter invoices, Lot.supplierId is the invoicing exporter (who was paid).
  lots Lot[]
  /// Present only when supplierType = FPO.
  fpoProfile FpoProfile?
  /// FPO profiles that name this supplier as their exporting intermediary.
  exportsForFpos FpoProfile[] @relation("FpoExportsVia")
  /// Receipt-line origins naming this supplier as the growing FPO.
  sourcingOrigins SourcingOrigin[] @relation("SourcingOriginFpo")
  /// Food-import / organic / FSVP certifications on file for this supplier.
  certifications SupplierCertification[]

  @@index([isActive])
  @@index([name])
  @@index([supplierType])
}

/// 1:1 profile for a Supplier of type FPO — cluster-level facts for flyers / website.
model FpoProfile {
  id                   String       @id @default(cuid())
  supplierId           String       @unique
  legalForm            FpoLegalForm @default(OTHER)
  registrationNumber   String       @default("")
  state                String       @default("")
  district             String       @default("")
  block                String?
  /// Self-reported by the FPO. Never shown without its as-of date.
  memberFarmerCount    Int          @default(0)
  memberFarmerCountAsOf DateTime    @default(now())
  womenFarmerCount     Int?
  primaryCrops         String[]     @default([])
  /// Exporter that invoices on the FPO's behalf, if any.
  exportsViaSupplierId String?
  onboardedAt          DateTime     @default(now())
  notes                String       @default("")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  supplier         Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  exportsVia       Supplier? @relation("FpoExportsVia", fields: [exportsViaSupplierId], references: [id])

  @@index([exportsViaSupplierId])
  @@index([state])
}

/// Where one receipt line's goods were grown — cluster level, never named farmers.
/// When the invoice comes from an exporter, Lot.supplierId is the INVOICING supplier (who was paid)
/// and SourcingOrigin.fpoSupplierId is the FPO (who grew it).
model SourcingOrigin {
  id                      String        @id @default(cuid())
  goodsReceiptLineId      String        @unique
  fpoSupplierId           String
  state                   String
  district                String
  village                 String?
  crop                    String
  variety                 String?
  /// e.g. "Rabi 2026" — optional alongside or instead of a precise harvestDate.
  harvestSeason           String?
  harvestDate             DateTime?
  contributingFarmerCount Int?
  organicStatus           OrganicStatus @default(CONVENTIONAL)
  /// Deliberately aggregate. Named farmer records are personal data of people in India.
  createdAt               DateTime      @default(now())

  goodsReceiptLine GoodsReceiptLine @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Cascade)
  fpoSupplier      Supplier         @relation("SourcingOriginFpo", fields: [fpoSupplierId], references: [id])

  @@index([fpoSupplierId])
  @@index([state, district])
  @@index([crop])
}

/// Links a Supplier to a store Product with pack/cost terms.
/// A product may have several suppliers; at most one should be isPreferred per product.
model SupplierProduct {
  /// Primary key uniquely identifying this supplier–product link.
  id           String   @id @default(cuid())
  /// Vendor side of the link.
  supplierId   String
  /// Store catalog product being supplied.
  productId    String
  /// Vendor's own SKU / item code for ordering.
  supplierSku  String   @default("")
  /// Units per case (order quantities often round up to whole cases).
  caseSize     Int      @default(1)
  /// Cost for one full case (informational; unitCost is used on PO lines). Stays 2 dp.
  caseCost     Decimal  @db.Decimal(12, 2)
  /// Cost per sellable unit from this supplier (default PO line unitCost). 4 dp.
  unitCost     Decimal  @db.Decimal(14, 4)
  /// Minimum order quantity in units (enforced on reorder suggestions).
  minOrderQty  Int      @default(1)
  /// When true, reorder suggestions prefer this supplier for the product.
  isPreferred  Boolean  @default(false)
  /// When this link was created.
  createdAt    DateTime @default(now())
  /// When pack/cost fields were last updated.
  updatedAt    DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([productId])
  @@index([supplierId])
  @@index([productId, isPreferred])
}

/// A purchase order to a supplier — store-scoped or co-op central (storeId null).
model PurchaseOrder {
  /// Primary key uniquely identifying this PO.
  id              String              @id @default(cuid())
  /// Human-readable sequential number (e.g. PO-000042) for dock paperwork.
  poNumber        String              @unique
  /// Vendor fulfilling this order.
  supplierId      String
  /// Destination store; null = co-op-level central buy (lines still reference store products).
  storeId         String?
  /// Draft → submitted → receiving lifecycle.
  status          PurchaseOrderStatus @default(DRAFT)
  /// Expected delivery date (from lead time or manually set).
  expectedDate    DateTime?
  /// When the PO left DRAFT (submitted to supplier / locked for edit).
  submittedAt     DateTime?
  /// User who created the draft.
  createdByUserId String
  /// ISO 4217 currency of the supplier invoice. unitCost on lines is always USD.
  currency        String              @default("USD") @db.Char(3)
  /// Multiply foreign amounts by this to get USD. Always 1 when currency is USD.
  fxRateToUsd     Decimal             @default(1) @db.Decimal(14, 6)
  /// Amount paid to the supplier in USD (when recorded).
  paidAmountUsd   Decimal?            @db.Decimal(12, 2)
  /// When the supplier was paid.
  paidAt          DateTime?
  /// Wire / cheque / LC reference for the supplier payment.
  paymentReference String?
  /// Sum of line totals (orderedQty × unitCost) before tax/shipping — always USD.
  subtotal        Decimal             @default(0) @db.Decimal(12, 2)
  /// Tax on the PO (entered by buyer; not computed from store sales tax).
  tax             Decimal             @default(0) @db.Decimal(12, 2)
  /// Freight / shipping charged on the PO.
  shipping        Decimal             @default(0) @db.Decimal(12, 2)
  /// subtotal + tax + shipping — amount expected on the supplier invoice (USD).
  total           Decimal             @default(0) @db.Decimal(12, 2)
  /// When the PO row was created.
  createdAt       DateTime            @default(now())
  /// When totals/status/lines were last updated.
  updatedAt       DateTime            @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  store     Store?              @relation(fields: [storeId], references: [id])
  createdBy User                @relation("PurchaseOrderCreatedBy", fields: [createdByUserId], references: [id])
  lines     PurchaseOrderLine[]
  receipts  GoodsReceipt[]
  /// Shipments this PO is loaded onto (at most one non-cancelled in practice).
  shipmentLinks ImportShipmentPurchaseOrder[]

  @@index([supplierId])
  @@index([storeId])
  @@index([status])
  @@index([createdByUserId])
  @@index([createdAt])
}

/// One ordered SKU on a purchase order.
model PurchaseOrderLine {
  /// Primary key uniquely identifying this PO line.
  id          String  @id @default(cuid())
  /// Parent purchase order.
  poId        String
  /// Product being ordered (store catalog row).
  productId   String
  /// Units requested from the supplier.
  orderedQty  Int
  /// Cumulative units accepted into stock across all goods receipts.
  receivedQty Int     @default(0)
  /// Negotiated / expected unit cost in USD (= unitCostForeign × fxRateToUsd, 4 dp).
  /// Always USD so every existing total and report stays unchanged.
  unitCost    Decimal @db.Decimal(14, 4)
  /// Unit cost in the PO currency when currency ≠ USD; null for USD POs.
  unitCostForeign Decimal? @db.Decimal(14, 4)
  /// orderedQty × unitCost at last recalculation (2 dp, USD).
  lineTotal   Decimal @db.Decimal(12, 2)
  /// When true, this line was closed short (short-receipt acknowledged).
  shortClosed Boolean @default(false)

  po               PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  product          Product            @relation(fields: [productId], references: [id])
  goodsReceiptLines GoodsReceiptLine[]
  shipmentLines    ImportShipmentLine[]

  @@index([poId])
  @@index([productId])
}

/// A dock receiving event against a submitted (or partially received) PO.
model GoodsReceipt {
  /// Primary key uniquely identifying this receipt.
  id               String   @id @default(cuid())
  /// Purchase order being received against.
  poId             String
  /// User who recorded the receipt (typically store admin at the back door).
  receivedByUserId String
  /// When goods were physically received.
  receivedAt       DateTime @default(now())
  /// Supplier invoice number on the paperwork, when known.
  invoiceNumber    String?
  /// Free-form notes (damaged pallet, partial truck, etc.).
  notes            String?
  /// When this receipt row was created.
  createdAt        DateTime @default(now())

  po         PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  receivedBy User               @relation("GoodsReceiptReceivedBy", fields: [receivedByUserId], references: [id])
  lines      GoodsReceiptLine[]

  @@index([poId])
  @@index([receivedByUserId])
  @@index([receivedAt])
}

/// Per-line quantities accepted/rejected on a goods receipt.
model GoodsReceiptLine {
  /// Primary key uniquely identifying this receipt line.
  id                String  @id @default(cuid())
  /// Parent goods receipt.
  receiptId         String
  /// PO line this receipt applies to.
  poLineId          String
  /// Product received (denormalized from PO line for reporting).
  productId         String
  /// Units accepted into sellable stock on this receipt.
  quantityReceived  Int
  /// Units rejected (damage / wrong item) — do NOT increment Product.stock.
  quantityRejected  Int     @default(0)
  /// Required when quantityRejected > 0.
  rejectionReason   String?
  /// Actual invoiced unit cost on this receipt (may differ from PO unitCost). 4 dp.
  unitCostActual    Decimal   @db.Decimal(14, 4)
  /// Per-unit landed-cost add-on from the import shipment allocation (0 for domestic). 4 dp.
  landedAddOnPerUnit Decimal  @default(0) @db.Decimal(14, 4)
  /// qty × (unitCostActual + landedAddOnPerUnit) — Phase 4 inventory valuation.
  receivedValue     Decimal   @default(0) @db.Decimal(12, 2)
  /// Import shipment that funded the add-on; null for domestic receipts.
  shipmentId        String?
  /// Supplier / dock lot number for the accepted units; null → auto-generated on receive.
  lotNumber         String?
  /// Sell-by / use-by date for the received lot (FEFO); null if unknown / N/A.
  expiryDate        DateTime?
  /// Harvest date for produce lots; null if N/A.
  harvestDate       DateTime?
  /// Country of origin (COOL); null if unknown.
  countryOfOrigin   String?

  receipt GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poLine  PurchaseOrderLine @relation(fields: [poLineId], references: [id])
  product Product           @relation(fields: [productId], references: [id])
  shipment ImportShipment?  @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  /// Lots created from this receipt line (one receipt line may seed one or more lots).
  lots    Lot[]
  /// Cluster-level growing origin (required for FPO / EXPORTER POs).
  sourcingOrigin SourcingOrigin?

  /// Backward: receipt → lines.
  @@index([receiptId])
  /// Backward: receipt line → PO line → purchase order.
  @@index([poLineId])
  @@index([productId])
  @@index([shipmentId])
}

/// An ocean/air container bringing overseas POs into the co-op warehouse.
model ImportShipment {
  /// Primary key uniquely identifying this shipment.
  id                   String               @id @default(cuid())
  /// Human-readable number (e.g. IMP-2026-0001) — year + sequence.
  shipmentNumber       String               @unique
  /// Planning → booked → water → port → cleared → delivered → received → costed → closed.
  status               ImportShipmentStatus @default(PLANNED)
  /// Sea FCL/LCL or air.
  mode                 ShipmentMode
  /// Incoterm on the commercial invoice.
  incoterm             Incoterm
  /// Origin port / airport code (free text; e.g. INNSA, INMAA).
  originPort           String               @default("")
  /// Destination port code; default Port of Houston.
  destinationPort      String               @default("USHOU")
  /// Ocean / air carrier name.
  carrier              String               @default("")
  /// Vessel + voyage or flight identifier.
  vesselVoyage         String               @default("")
  /// Container number when known (FCL).
  containerNumber      String?
  /// Bill of lading / AWB number.
  billOfLadingNumber   String?
  /// Customs entry / ISF / ACE entry number when filed.
  customsEntryNumber   String?
  /// Estimated time of departure.
  etd                  DateTime?
  /// Estimated time of arrival.
  eta                  DateTime?
  /// Actual departure from origin.
  actualDeparture      DateTime?
  /// Actual arrival at destination port.
  actualArrival        DateTime?
  /// When customs cleared the entry.
  clearedAt            DateTime?
  /// When goods arrived at the destination warehouse/store.
  deliveredAt          DateTime?
  /// Where the container is delivered; defaults to CooperativeSettings.mainWarehouseId.
  destinationStoreId   String
  /// Required while status = CUSTOMS_HOLD — why CBP/FDA is holding the entry.
  holdReason           String?
  /// User who created the shipment.
  createdByUserId      String
  /// When this shipment row was created.
  createdAt            DateTime             @default(now())
  /// When status / logistics fields were last updated.
  updatedAt            DateTime             @updatedAt

  destinationStore Store                         @relation("ImportShipmentDestination", fields: [destinationStoreId], references: [id])
  createdBy        User                          @relation("ImportShipmentCreatedBy", fields: [createdByUserId], references: [id])
  purchaseOrders   ImportShipmentPurchaseOrder[]
  lines            ImportShipmentLine[]
  costs            ShipmentCost[]
  events           ShipmentEvent[]
  /// Goods receipt lines that applied this shipment's landed-cost allocation.
  goodsReceiptLines GoodsReceiptLine[]
  /// Compliance / customs paperwork attached to this shipment.
  documents ShipmentDocument[]
  /// True-up / restock-reversal COGS variances recognised against this shipment.
  landedCostVariances LandedCostVariance[]

  @@index([status])
  @@index([destinationStoreId])
  @@index([createdByUserId])
  @@index([eta])
  @@index([createdAt])
}

/// Join: one consolidated container may carry several FPOs' purchase orders.
/// A PO may sit on at most one non-cancelled shipment (enforced in service).
model ImportShipmentPurchaseOrder {
  /// Primary key uniquely identifying this join row.
  id         String   @id @default(cuid())
  /// Shipment carrying this PO.
  shipmentId String
  /// Purchase order loaded onto the shipment.
  poId       String
  /// When the PO was attached.
  createdAt  DateTime @default(now())

  shipment ImportShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  po       PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, poId])
  @@index([poId])
  @@index([shipmentId])
}

/// Per PO line on a shipment — quantity loaded and customs valuation inputs.
model ImportShipmentLine {
  /// Primary key uniquely identifying this shipment line.
  id               String   @id @default(cuid())
  /// Parent shipment.
  shipmentId       String
  /// PO line being shipped.
  poLineId         String
  /// Units on this container (may be a partial PO line).
  quantity         Int
  /// Gross weight in kilograms for freight allocation.
  grossWeightKg    Decimal? @db.Decimal(12, 3)
  /// Volume in cubic metres for LCL allocation.
  volumeCbm        Decimal? @db.Decimal(12, 4)
  /// Harmonized Tariff Schedule code when known.
  htsCode          String?
  /// Duty rate percent from the entry (e.g. 6.5).
  dutyRatePercent  Decimal? @db.Decimal(8, 4)
  /// Customs value in USD; defaults to quantity × PO line unitCost.
  customsValueUsd  Decimal  @db.Decimal(12, 2)
  /// Duty amount from the customs entry when known (LINE_SPECIFIC duty allocation).
  dutyAmountUsd    Decimal? @db.Decimal(12, 2)
  /// When this line was created.
  createdAt        DateTime @default(now())
  /// When quantity / weight / duty fields were last updated.
  updatedAt        DateTime @updatedAt

  shipment ImportShipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  poLine   PurchaseOrderLine @relation(fields: [poLineId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, poLineId])
  @@index([shipmentId])
  @@index([poLineId])
}

/// A freight / duty / fee cost on a shipment — estimates are superseded, never edited after receive.
model ShipmentCost {
  /// Primary key uniquely identifying this cost row.
  id               String              @id @default(cuid())
  /// Parent shipment.
  shipmentId       String
  /// Kind of landed cost.
  costType         ShipmentCostType
  /// Vendor that invoiced this cost (carrier, broker, warehouse…).
  vendorName       String              @default("")
  /// Vendor invoice number when known.
  invoiceNumber    String?
  /// ISO 4217 currency of amountForeign.
  currency         String              @default("USD") @db.Char(3)
  /// Amount in the vendor's currency.
  amountForeign    Decimal             @db.Decimal(14, 4)
  /// FX rate used to convert amountForeign → amountUsd.
  fxRateToUsd      Decimal             @default(1) @db.Decimal(14, 6)
  /// USD amount allocated / paid (2 dp).
  amountUsd        Decimal             @db.Decimal(12, 2)
  /// How this cost is spread across shipment lines.
  allocationBasis  CostAllocationBasis @default(VALUE)
  /// Working estimate vs final invoice.
  status           ShipmentCostStatus  @default(ESTIMATED)
  /// When status = FINAL, the ESTIMATED row this replaces (if any).
  supersedesCostId String?             @unique
  /// When this cost was paid.
  paidAt           DateTime?
  /// Amount paid in USD.
  paidAmountUsd    Decimal?            @db.Decimal(12, 2)
  /// Wire / cheque reference for this cost payment.
  paymentReference String?
  /// When this cost row was created.
  createdAt        DateTime            @default(now())
  /// When amount / status / payment fields were last updated.
  updatedAt        DateTime            @updatedAt

  shipment   ImportShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  supersedes ShipmentCost?  @relation("ShipmentCostSupersedes", fields: [supersedesCostId], references: [id], onDelete: SetNull)
  supersededBy ShipmentCost? @relation("ShipmentCostSupersedes")

  @@index([shipmentId])
  @@index([costType])
  @@index([status])
}

/// Append-only timeline for an import shipment (status, ETA, holds, notes).
model ShipmentEvent {
  /// Primary key uniquely identifying this event.
  id          String   @id @default(cuid())
  /// Parent shipment.
  shipmentId  String
  /// Short event kind code (STATUS_CHANGE, ETA_CHANGE, HOLD, NOTE, …).
  eventType   String
  /// Free-text detail / note.
  message     String   @default("")
  /// Optional structured payload (before/after status, ETA, etc.).
  payload     Json?
  /// User who recorded the event; null for system jobs.
  createdByUserId String?
  /// When the event occurred / was recorded.
  createdAt   DateTime @default(now())

  shipment  ImportShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("ShipmentEventCreatedBy", fields: [createdByUserId], references: [id])

  @@index([shipmentId, createdAt])
  @@index([createdByUserId])
}

/// Binary file stored via lib/storage (local disk or S3). Never publicly served —
/// downloads go through an authenticated route. Never deleted once attached to a
/// received shipment.
model Document {
  /// Primary key uniquely identifying this document.
  id               String   @id @default(cuid())
  /// Opaque key in the storage backend (local path segment or S3 object key).
  storageKey       String   @unique
  /// Original filename as uploaded (for download Content-Disposition).
  fileName         String
  /// MIME type — only application/pdf, image/jpeg, image/png are accepted.
  mimeType         String
  /// Size in bytes (max 15 MB at upload).
  sizeBytes        Int
  /// SHA-256 hex digest of the file bytes.
  sha256           String
  /// User who uploaded the file.
  uploadedByUserId String
  /// When the file was stored.
  createdAt        DateTime @default(now())

  uploadedBy       User                     @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])
  certifications   SupplierCertification[]
  shipmentDocuments ShipmentDocument[]

  @@index([uploadedByUserId])
  @@index([sha256])
  @@index([createdAt])
}

/// A verified certification on a supplier (FSVP, organic, facility registration, …).
model SupplierCertification {
  /// Primary key uniquely identifying this certification row.
  id               String            @id @default(cuid())
  /// Supplier this certification belongs to.
  supplierId       String
  /// Kind of certificate / verification.
  certType         CertificationType
  /// Number / registration id on the certificate.
  certNumber       String            @default("")
  /// When the certificate was issued.
  issuedAt         DateTime
  /// Expiration date when the cert has one; null if open-ended.
  expiresAt        DateTime?
  /// When the co-op should next review this verification (FSVP annual review, etc.).
  nextReviewDue    DateTime?
  /// Scanned certificate PDF/image, when filed.
  documentId       String?
  /// User who verified the certificate is on file / current.
  verifiedByUserId String
  /// When verification was recorded.
  verifiedAt       DateTime          @default(now())
  /// Free-form notes (scope, products covered, broker comments).
  notes            String            @default("")
  /// When this row was created.
  createdAt        DateTime          @default(now())
  /// When fields were last updated.
  updatedAt        DateTime          @updatedAt

  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  verifiedBy User      @relation("CertificationVerifiedBy", fields: [verifiedByUserId], references: [id])

  @@index([supplierId])
  @@index([certType])
  @@index([expiresAt])
  @@index([nextReviewDue])
  @@index([documentId])
  @@index([verifiedByUserId])
}

/// COGS already consumed that must be recognised when landed add-on changes (true-up),
/// or reversed when refund-restock returns units to a post-sale-trued-up lot.
/// Never rewrite SaleItemLot.unitCostSnapshot — snapshots are frozen at sale time.
model LandedCostVariance {
  /// Primary key uniquely identifying this variance row.
  id               String                   @id @default(cuid())
  /// Shipment whose cost change drove this variance; null only if unknown on restock reversal.
  shipmentId       String?
  /// Lot whose consumed units are being revalued.
  lotId            String
  /// Change in landed add-on per unit (new − previously applied). 4 dp.
  deltaPerUnit     Decimal                  @db.Decimal(14, 4)
  /// Units affected. Negative for RESTOCK_REVERSAL.
  units            Int
  /// deltaPerUnit × units, rounded to 2 dp (can be negative).
  amountUsd        Decimal                  @db.Decimal(12, 2)
  /// When this COGS was recognised / reversed.
  recognisedAt     DateTime                 @default(now())
  /// User (or system actor) who booked the variance.
  createdByUserId  String
  /// TRUE_UP vs RESTOCK_REVERSAL.
  reason           LandedCostVarianceReason
  /// When this row was created.
  createdAt        DateTime                 @default(now())

  shipment  ImportShipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  lot       Lot             @relation(fields: [lotId], references: [id], onDelete: Restrict)
  createdBy User            @relation("LandedCostVarianceCreatedBy", fields: [createdByUserId], references: [id])

  @@index([shipmentId])
  @@index([lotId])
  @@index([recognisedAt])
  @@index([createdByUserId])
  @@index([reason])
}

/// Compliance / customs paperwork attached to an import shipment.
model ShipmentDocument {
  /// Primary key uniquely identifying this attachment.
  id               String          @id @default(cuid())
  /// Parent shipment.
  shipmentId       String
  /// Kind of paperwork.
  docType          ShipmentDocType
  /// Stored file.
  documentId       String
  /// Entry / BOL / notice number when known.
  referenceNumber  String?
  /// User who attached the document.
  uploadedByUserId String
  /// When the document was attached to the shipment.
  uploadedAt       DateTime        @default(now())

  shipment   ImportShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Restrict)
  uploadedBy User           @relation("ShipmentDocumentUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([shipmentId])
  @@index([docType])
  @@index([documentId])
  @@index([uploadedByUserId])
}

/// A tracked inventory lot (batch) of a product at a store.
/// Available to sell from a lot = quantityRemaining - quantityReserved, and ONLY when
/// status = ACTIVE. QUARANTINED and RECALLED lots are never sellable.
/// Lot-level unitCost is the foundation for accurate margin — product.cost alone averages away truth.
model Lot {
  /// Primary key uniquely identifying this lot.
  id                 String    @id @default(cuid())
  /// Human-readable lot / batch code (unique per product+store).
  lotNumber          String
  /// Product this lot belongs to.
  productId          String
  /// Store holding this lot's physical inventory.
  storeId            String
  /// Supplier this lot came from; null for legacy stock with no known supplier.
  supplierId         String?
  /// Goods-receipt line that created this lot; null for opening / legacy stock.
  goodsReceiptLineId String?
  /// When the crop / product was harvested (farm / produce lots); null if N/A.
  harvestDate        DateTime?
  /// When the product was packed; null if N/A.
  packDate           DateTime?
  /// Sell-by / use-by date for FEFO and expiry alerts; null if no expiry.
  expiryDate         DateTime?
  /// Units originally received into this lot.
  quantityReceived   Int
  /// Units still physically in this lot (before subtracting quantityReserved).
  quantityRemaining  Int
  /// Units spoken for by unpaid PENDING sales against this lot (default 0).
  quantityReserved   Int       @default(0)
  /// Lot lifecycle — only ACTIVE is sellable.
  status             LotStatus @default(ACTIVE)
  /// Country of origin label (COOL); null when unknown.
  countryOfOrigin    String?
  /// When this lot was received into the store.
  receivedAt         DateTime
  /// Cost basis for THIS lot (per unit). 4 dp — multiply by qty then round to 2 dp for value.
  /// Lot-level cost is the foundation for accurate margin. Two lots of the same product bought at
  /// different prices have different costs; a single product-level cost averages away the truth.
  /// For imports this is invoice unitCostActual + landedAddOnApplied.
  unitCost           Decimal   @db.Decimal(14, 4)
  /// Landed-cost add-on per unit baked into unitCost (0 for domestic / opening stock). 4 dp.
  landedAddOnApplied Decimal   @default(0) @db.Decimal(14, 4)
  /// Scannable lot label (supplier GS1-128 or a store-printed label), normalized like
  /// ProductBarcode.code. Scanning it goes straight to this lot — needed for lot-level counts.
  barcode            String?
  /// When this lot row was created.
  createdAt          DateTime  @default(now())
  /// When this lot was last updated.
  updatedAt          DateTime  @updatedAt

  product          Product           @relation(fields: [productId], references: [id])
  store            Store             @relation(fields: [storeId], references: [id])
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  goodsReceiptLine GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id])
  /// Stock adjustments that reference this lot (e.g. RECEIPT).
  stockAdjustments StockAdjustment[]
  /// Sale line allocations drawn from this lot.
  saleItemLots SaleItemLot[]
  /// Write-offs that reference this lot (e.g. EXPIRED).
  inventoryWriteOffs InventoryWriteOff[]
  /// Recall line items that quarantine / recall this lot.
  recallLots RecallLot[]
  /// Physical count lines taken at lot level.
  stockCountLines StockCountLine[]
  /// Refund restock rows that returned units into this lot.
  refundRestocks RefundRestockLot[]
  /// Landed-cost variances recognised against consumed units of this lot.
  landedCostVariances LandedCostVariance[]

  /// One lot number per product per store.
  @@unique([productId, lotNumber, storeId])
  /// A lot barcode resolves to exactly one lot in a store. NULLs (most lots) do not collide.
  @@unique([storeId, barcode])
  /// FEFO picking query: active lots for a product ordered by expiry.
  @@index([productId, status, expiryDate])
  /// Recall / quarantine sweeps by status.
  @@index([status])
  /// Near-expiry alert queries.
  @@index([expiryDate])
  /// Current-location / store-scoped lot lists (traceability + POS).
  @@index([storeId])
  /// Backward shortcut: lot → supplier without joining the goods receipt.
  @@index([supplierId])
  /// Backward trace: lot → goods receipt line → PO → supplier/FPO.
  @@index([goodsReceiptLineId])
}

/// What kind of physical count this is.
enum StockCountType {
  /// Scheduled partial count (a rotating subset of products).
  CYCLE
  /// Wall-to-wall count of everything in the store.
  FULL
  /// Ad-hoc check of a specific product or lot.
  SPOT
  /// Verifying a delivery against what was receipted.
  RECEIVING_VERIFY
}

/// Lifecycle of a stock count. Counts are CANCELLED, never deleted.
enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Lifecycle of one line within a stock count.
enum StockCountLineStatus {
  PENDING
  COUNTED
  RECOUNT_REQUIRED
  RESOLVED
}

/// Why counted stock differs from what the system expected.
/// UNKNOWN is a legitimate answer and must stay available. Forcing a counter to pick a cause they
/// don't know produces confident wrong data, which is worse than an honest blank.
enum ShrinkageReason {
  THEFT_SUSPECTED
  DAMAGE
  SPOILAGE
  EXPIRY
  RECEIVING_ERROR
  COUNTING_ERROR
  SYSTEM_ERROR
  UNKNOWN
}

/// A physical count of stock at one store, built on the lot model.
model StockCount {
  id               String           @id @default(cuid())
  storeId          String
  type             StockCountType
  status           StockCountStatus @default(DRAFT)
  scheduledFor     DateTime?
  /// When counting began — the moment every line's expectedQuantity was frozen.
  startedAt        DateTime?
  completedAt      DateTime?
  /// Null when the cycle-count scheduler created the count rather than a person.
  createdByUserId  String?
  countedByUserId  String?
  approvedByUserId String?
  /// Set with approvedByUserId; a COMPLETED count with approvedAt set has been applied to stock.
  approvedAt       DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  store      Store            @relation(fields: [storeId], references: [id])
  createdBy  User?            @relation("StockCountCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  countedBy  User?            @relation("StockCountCountedBy", fields: [countedByUserId], references: [id])
  approvedBy User?            @relation("StockCountApprovedBy", fields: [approvedByUserId], references: [id])
  lines      StockCountLine[]

  @@index([storeId, status])
}

/// One product (or one lot of a product) within a stock count.
model StockCountLine {
  id                String               @id @default(cuid())
  countId           String
  productId         String
  /// Null for a product-level count; set when counting a specific lot.
  lotId             String?
  /// expectedQuantity is frozen when the count starts. Sales continuing during the count are
  /// reconciled at approval, not by moving the target — otherwise the variance is meaningless.
  expectedQuantity  Int
  /// Null until counted.
  countedQuantity   Int?
  countedByUserId   String?
  countedAt         DateTime?
  /// expectedQuantity minus the lot's quantity at the moment of the latest (re)count (for an entry
  /// queued offline, the moment it was physically counted, not when it synced):
  /// net units that left (sales) or came back (restocked refunds) between startCount and counting.
  movementDuringCount Int?
  /// Final counted figure − (expectedQuantity − movementDuringCount): the true variance after
  /// mid-count sales. Negative = shrinkage. Null until counted.
  variance          Int?
  /// variance × lot unit cost. Null until counted.
  varianceValue     Decimal?             @db.Decimal(12, 2)
  reasonCode        ShrinkageReason?
  recountedQuantity Int?
  recountedByUserId String?
  recountedAt       DateTime?
  /// Client-minted key for the first count submission. A queued offline count is replayed with the
  /// same key, so a retry after a lost response returns the stored result instead of a 409.
  countSubmissionKey   String?           @unique
  /// Same, for the recount submission.
  recountSubmissionKey String?           @unique
  status            StockCountLineStatus @default(PENDING)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  count       StockCount @relation(fields: [countId], references: [id])
  product     Product    @relation(fields: [productId], references: [id])
  countedBy   User?      @relation("StockCountLineCountedBy", fields: [countedByUserId], references: [id])
  recountedBy User?      @relation("StockCountLineRecountedBy", fields: [recountedByUserId], references: [id])
  /// Restrict, not SET NULL: losing the lot would silently turn a lot-level line into a product-level one.
  lot     Lot?       @relation(fields: [lotId], references: [id], onDelete: Restrict)

  /// A lot appears at most once per count.
  @@unique([countId, lotId])
  @@index([countId])
  @@index([productId])
  @@index([lotId])
}

/// How serious a recall is — drives regulator / public-notice obligations.
enum RecallSeverity {
  ADVISORY
  VOLUNTARY
  MANDATORY
}

/// Recall lifecycle. Records are NEVER deleted (regulatory retention) — CANCELLED is archive.
enum RecallStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Channel used to notify a member about a recall.
enum RecallNotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

/// A product recall campaign. Quarantine happens at initiate; RECALLED + notifications at activate.
/// Never delete — archive via CANCELLED / COMPLETED only.
model Recall {
  id                 String         @id @default(cuid())
  /// Human-readable recall id (e.g. REC-20260915-0001).
  recallNumber       String         @unique
  initiatedByUserId  String
  initiatedAt        DateTime       @default(now())
  reason             String
  severity           RecallSeverity
  status             RecallStatus   @default(DRAFT)
  /// When regulators were notified (null until recorded).
  regulatorNotifiedAt DateTime?
  closedAt           DateTime?
  /// Public-facing notice text (press / store posting).
  publicNotice       String?        @db.Text
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  initiatedBy   User                 @relation("RecallInitiatedBy", fields: [initiatedByUserId], references: [id])
  lots          RecallLot[]
  notifications RecallNotification[]

  @@index([status])
  @@index([initiatedAt])
  @@index([initiatedByUserId])
}

/// Lots under a recall, with shelf snapshot and recovery/disposal tracking.
model RecallLot {
  id                 String @id @default(cuid())
  recallId           String
  lotId              String
  /// quantityRemaining on the lot at initiate (quarantine snapshot).
  quantityAtRecall   Int
  /// Units returned by customers / pulled from circulation after activate.
  quantityRecovered  Int    @default(0)
  /// Units destroyed / disposed (never restocked).
  quantityDisposed   Int    @default(0)

  recall Recall @relation(fields: [recallId], references: [id])
  lot    Lot    @relation(fields: [lotId], references: [id])

  /// One lot per recall.
  @@unique([recallId, lotId])
  /// Store banner / active-recall-for-store: find recalls by lot.
  @@index([lotId])
  @@index([recallId])
}

/// Outreach row for one member on one channel. Never delete — acknowledgement is evidence.
model RecallNotification {
  id                 String                     @id @default(cuid())
  recallId           String
  memberId           String
  channel            RecallNotificationChannel
  sentAt             DateTime?
  acknowledgedAt     DateTime?
  /// Units this member purchased from recalled lot(s) at activate time.
  quantityPurchased  Int

  recall Recall @relation(fields: [recallId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@unique([recallId, memberId, channel])
  /// Dispatch / ack sweeps by recall.
  @@index([recallId])
  /// Member notification history.
  @@index([memberId])
}

/// Idempotency log for Stripe webhook deliveries.
/// Stripe guarantees at-least-once delivery (retries + confirm-payment races), so each
/// event id must be processed at most once. Insert-before-handle; duplicate id → skip.
model ProcessedStripeEvent {
  /// Stripe event id (evt_…) — primary key enforces uniqueness.
  id          String   @id
  /// Event type string (e.g. payment_intent.succeeded) for ops debugging.
  type        String
  /// Sale this event was applied to, when resolved.
  saleId      String?
  /// When Harvestlink accepted/processed this event.
  processedAt DateTime @default(now())

  @@index([saleId])
  @@index([processedAt])
}

/// Append-only financial / security audit trail.
/// Application code ONLY inserts. No update/delete endpoints exist — rewriting history
/// would defeat "who changed this, and when?" for operatorPercent, payouts, refunds, etc.
/// No FK to User/Store so deleting those rows cannot cascade-erase evidence.
model AuditLog {
  id         String   @id @default(cuid())
  /// Actor who performed the action; null for anonymous failed logins.
  userId     String?
  /// Store scope when the action was store-specific.
  storeId    String?
  /// Stable action code (e.g. STORE_OPERATOR_PERCENT_CHANGE, LOGIN_FAILURE).
  action     String
  /// Entity kind (Store, Product, Payout, Sale, User, Session, …).
  entityType String
  /// Primary key of the entity when applicable.
  entityId   String?
  /// Snapshot before the change (JSON); omit for creates / login events as needed.
  before     Json?
  /// Snapshot after the change (JSON); never store plaintext passwords.
  after      Json?
  /// Client IP best-effort (may be proxy-forwarded).
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([storeId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
}
