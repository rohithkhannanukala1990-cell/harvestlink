# Example environment variables for the Harvestlink backend.
# Copy this file to .env and replace placeholder values before running locally.

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://harvestlink:harvestlink@localhost:5432/harvestlink?schema=public"

# Secret used to sign and verify JWT access tokens
JWT_SECRET="change-me-to-a-long-random-secret"

# HTTP port the Express server listens on
PORT=3001

# Optional seed credentials (used by `npm run prisma:seed`)
SEED_ADMIN_EMAIL="admin@harvestlink.local"
SEED_ADMIN_PASSWORD="ChangeMeAdmin123!"
SEED_STORE_ADMIN_EMAIL="storeadmin@harvestlink.local"
SEED_STORE_ADMIN_PASSWORD="ChangeMeStore123!"
SEED_CASHIER_EMAIL="cashier@harvestlink.local"
SEED_CASHIER_PASSWORD="ChangeMeCashier123!"

# Stripe — co-op account is merchant of record / payout destination (not the store operator)
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_CURRENCY="usd"
FRONTEND_URL="http://localhost:5173"
